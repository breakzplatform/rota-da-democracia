{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carona-pela-democracia",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "carona", "database_id": "d93e5145-639c-49e4-bc1d-c2c1dd23ab71", "migrations_dir": "migrations" }
  ],
  "triggers": { "crons": ["0 * * * *"] },
  "vars": {
    // Real widget; tests and wrangler dev use .dev.vars / test bindings.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFcZpTsTGKKJM9YZ",
    "ALLOWED_HOSTNAMES": "carona-pela-democracia.joselito.workers.dev,localhost"
  },
  "observability": { "enabled": true }
}
